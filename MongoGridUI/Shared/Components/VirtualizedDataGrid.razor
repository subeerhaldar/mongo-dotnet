@typeparam TItem

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Title</h5>
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" style="width: 200px;"
                   placeholder="Search..." @bind="SearchText" @bind:event="oninput" @onkeyup="HandleSearch" />
            <button class="btn btn-outline-primary btn-sm" @onclick="RefreshData">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <div class="card-body">
        @if (IsLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading data...</div>
            </div>
        }
        else if (TotalCount == 0)
        {
            <div class="text-center py-4">
                <i class="bi bi-inbox-fill text-muted" style="font-size: 3rem;"></i>
                <div class="mt-2 text-muted">No data found</div>
            </div>
        }
        else
        {
            <!-- Performance optimized virtual scrolling -->
            <div class="table-responsive" style="height: 600px; overflow-y: auto;">
                <table class="table table-hover table-striped">
                    <thead class="table-dark sticky-top">
                        <tr>
                            @HeaderTemplate
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="VisibleItems" Context="item" ItemSize="50" OverscanCount="5">
                            <RowTemplate>
                                @RowTemplate(item)
                            </RowTemplate>
                        </Virtualize>
                    </tbody>
                </table>
            </div>

            <!-- Performance info -->
            <div class="d-flex justify-content-between align-items-center mt-2 text-muted small">
                <span>Showing @VisibleItems.Count() of @TotalCount total items (virtualized for performance)</span>
                <div class="d-flex align-items-center gap-2">
                    <span>Items per page:</span>
                    <select class="form-select form-select-sm" style="width: auto;" @bind="PageSize" @onchange="HandlePageSizeChange">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                    </select>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Virtualized Data Grid";
    [Parameter] public RenderFragment HeaderTemplate { get; set; } = null!;
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = null!;
    [Parameter] public Func<Task<(IEnumerable<TItem> Items, int TotalCount)>> LoadDataFunc { get; set; } = null!;

    private List<TItem> AllItems = new();
    private IEnumerable<TItem> VisibleItems = new List<TItem>();
    private bool IsLoading = true;
    private string SearchText = "";
    private int PageSize = 100;
    private int TotalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var (items, totalCount) = await LoadDataFunc();
            AllItems = items.ToList();
            TotalCount = totalCount;
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void ApplyFilters()
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            VisibleItems = AllItems.Take(PageSize);
        }
        else
        {
            // Basic client-side filtering for demo - in production, this should be server-side
            VisibleItems = AllItems
                .Where(item => item?.ToString()?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) == true)
                .Take(PageSize);
        }
    }

    private async Task HandleSearch()
    {
        ApplyFilters();
        StateHasChanged();
    }

    private async Task HandlePageSizeChange()
    {
        ApplyFilters();
        StateHasChanged();
    }
}